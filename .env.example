# LLM backend: "ollama" (local, default), "openai" (any OpenAI-compatible API),
# or "openrouter" (free-model auto-discovery + automatic failover)
LLM_BACKEND=ollama
# Ollama settings (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Speed: cap reply length (lower = faster replies) and keep the model loaded between messages
OLLAMA_NUM_PREDICT=256
OLLAMA_KEEP_ALIVE=30m
# Speed: how many recent messages are sent to the model (lower = faster)
HISTORY_LIMIT=12
# Optional: OpenAI-compatible fallback for a smaller brain (Groq, OpenRouter, OpenAI...)
# LLM_BACKEND=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=llama-3.3-70b-versatile

# OpenRouter: free models with auto-discovery and failover.
# Get your key at https://openrouter.ai/keys
# LLM_BACKEND=openrouter
# OPENROUTER_API_KEY=sk-or-...
# Optional: force a specific model (must be a free one). Leave unset to auto-pick the best free model.
# OPENROUTER_MODEL=

# Persona
PERSONA_NAME=Yoru

# --- Discord bot (official BOT token from discord.com/developers — NEVER your account token) ---
# DISCORD_TOKEN=
# Your Discord user ID(s), comma-separated. Owner = full tool access. Get it: Discord settings > Advanced > Developer Mode > right-click your name > Copy ID
# OWNER_DISCORD_IDS=

# --- Autonomy / watchdog ---
# WATCHDOG=on
# WATCHDOG_INTERVAL_MS=900000

# --- File index roots (comma-separated, ~ = home) ---
# INDEX_ROOTS=~/

# --- Owner-only lookup index: drop your CSV/TXT (or PDF with poppler installed) here ---
# LOOKUP_DIR=data/lookups

# --- Visual character panel (v0.4) ---
PANEL_PORT=4174

# --- Owner control panel (commands, economy, verification, servers) ---
# Separate port so it never conflicts with the visual character panel.
OWNER_PANEL_PORT=4175