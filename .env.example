# LLM backend: "ollama" (local, default) or "openai" (any OpenAI-compatible API)
LLM_BACKEND=ollama
# Ollama settings (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Optional: OpenAI-compatible fallback for a smarter brain (Groq, OpenRouter, OpenAI...)
# LLM_BACKEND=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=llama-3.3-70b-versatile

# Persona
PERSONA_NAME=Yoru

# --- Discord bot (official BOT token from discord.com/developers — NEVER your account token) ---
# DISCORD_TOKEN=
# Your Discord user ID(s), comma-separated. Owner = full tool access. Get it: Discord settings > Advanced > Developer Mode > right-click your name > Copy ID
# OWNER_DISCORD_IDS=

# --- Autonomy / watchdog ---
# WATCHDOG=on
# WATCHDOG_INTERVAL_MS=900000

# --- File index roots (comma-separated, ~ = home) ---
# INDEX_ROOTS=~/

# --- Owner-only lookup index: drop your CSV/TXT (or PDF with poppler installed) here ---
# LOOKUP_DIR=data/lookups
